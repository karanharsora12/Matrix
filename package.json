{
  "name": "matrix-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "matrix-backend",
    "matrix-frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev --workspace=matrix-backend\" \"npm run dev --workspace=matrix-frontend\"",
    "dev:backend": "npm run dev --workspace=matrix-backend",
    "dev:frontend": "npm run dev --workspace=matrix-frontend",
    "build:frontend": "npm run build --workspace=matrix-frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
